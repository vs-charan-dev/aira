# All paths resolve under the current E-drive workspace.
AIRA_DATA_DIR=E:/Havetobuild/AIRA/data
AIRA_CACHE_DIR=E:/Havetobuild/AIRA/.cache
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Recommended: add the key in AIRA Settings (encrypted with Windows DPAPI).
# Optional environment override; never commit a populated .env.
GEMINI_API_KEY=
# Optional OpenCode provider/model override; blank uses google/GEMINI_STANDARD_MODEL.
AIRA_CODING_MODEL=
# Known invoice presentation uses an exact scripted repair. Other projects use OpenCode.
AIRA_INVOICE_REPAIR_MODE=deterministic
# Optional verified-fix notifications. Configure-Telegram.cmd sets these locally.
AIRA_TELEGRAM_ENABLED=false
AIRA_TELEGRAM_BOT_TOKEN=
AIRA_TELEGRAM_CHAT_ID=
# Configurable so retired/restricted models can be replaced without code edits.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_STANDARD_MODEL=gemini-3.8-flash
# Windows-Use defaults to GEMINI_STANDARD_MODEL, using the same saved Gemini key.
# Optional override for desktop text reasoning; no Live/audio model here.
AIRA_DESKTOP_MODEL=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# YouTube study models; can also be selected on the task board.
# 2.5 Flash / Flash-Lite remain selectable for keys with access.
AIRA_YOUTUBE_SUMMARY_MODEL=gemini-3.5-flash-lite
AIRA_YOUTUBE_IMAGE_MODEL=gemini-3-pro-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Cost controls. Zero disables an individual limit. Applies to Live sessions.
AIRA_LIVE_IDLE_SECONDS=120
AIRA_LIVE_MAX_SECONDS=600
# Soft threshold: usage reports arrive after generation; not a billing cap.
AIRA_LIVE_MAX_ESTIMATED_USD=0
# Default counts retained context again per turn. Change only after reconciliation.
AIRA_LIVE_USAGE_MODE=per_turn
